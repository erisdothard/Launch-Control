# Copy to .env (git-ignored). Never commit real values.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only when leadgen itself runs inside Docker: host path of tools/leadgen/out
LEADGEN_HOST_OUT_DIR=

# CRM automation: the worker asks the CRM to send due follow-ups (crm/src/app/api/automation/send-follow-ups).
AUTOMATION_SECRET=
CRM_URL=https://crm.golaunchcontrol.com

# Deliverability check (leadgen/deliverability.py). The DNS half (SPF/DMARC/DKIM) runs unless this is off.
DELIVERABILITY_CHECK=
# The mail-tester half sends one test email per round from MS_APP_MAILBOX; opt in with "on".
MAILTESTER_CHECK=
